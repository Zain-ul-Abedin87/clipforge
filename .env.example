# ClipForge config. Copy this file to ".env" and fill values yourself.
# Never paste keys into chat. .env is git-ignored.

# --- LLM scene labels (step 3, optional: without a key, heuristic labels are used) ---
ANTHROPIC_API_KEY=
# Estimated cost per 25-min video (~180 scenes); the real cost is shown in Stats after each run:
#   claude-opus-5-5    ~$0.30  (best labels)
#   claude-sonnet-5-5  ~$0.16
#   claude-haiku-4-5   ~$0.08  (cheapest, fits the $0.05-0.15 target)
LLM_MODEL=claude-opus-5-5
# AI Footage Agent (step 4): Claude writes the stock searches per scene, re-searches weak scenes and
# checks official product photos. Uses the same key and model. Set to "off" to use rule-based searches.
FOOTAGE_AGENT=on

# --- TTS narration (Mode B: script only). Empty = the computer's built-in Windows voice (robotic, for drafts);
# set a provider for a natural voice. Glossary lines "Name = spoken form" (inputs/glossary.txt) change only
# what the engine reads, never the script.
# TTS_PROVIDER=elevenlabs | openai | piper | windows   (WINDOWS_TTS_RATE=-10..10, default 1)
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_INSTRUCTIONS=
# Piper (local, free): path to piper.exe and a .onnx voice
PIPER_PATH=
PIPER_MODEL=

# --- Exact-model footage policy (default) ---
# Videos use ONLY your own uploads, press kit / official brand media and verified clips of the exact
# model harvested from YouTube into workspace/models/<brand>_<model>/ (`harvest-model`). Pexels,
# Pixabay, Unsplash, Wikimedia, Archive.org, Storyblocks and CC/web crawls are never searched unless:
GENERIC_STOCK=off
# The assets step harvests products that have no vault yet (off = only use vaults you harvested).
AUTO_HARVEST=on
# CLIP prompt word for the machine (default: the niche's product category, else "lawn mower").
HARVEST_CATEGORY=
HARVEST_MAX_VIDEOS=6
HARVEST_WINDOWS=4
HARVEST_WINDOW_SECONDS=20
# Talking-head filter: keep a shot only if the machine prompt beats the worst negative prompt by
# HARVEST_MARGIN (raise it for a stricter vault), and the machine score is at least HARVEST_MIN_POSITIVE.
HARVEST_MARGIN=0.005
HARVEST_MIN_POSITIVE=0.2
HARVEST_MAX_NEGATIVE=0.34
# "HRX217" also matches trim codes like "HRX217HZA" in titles (off = exact token only).
HARVEST_ALLOW_TRIMS=on
# CLIP profile for walkaround harvests: machine (strict) | handson (relaxed close-ups; keyword mode default).
HARVEST_PROFILE=machine
HANDSON_MARGIN=0
# YouTube Shorts (15-60 s, vertical) are accepted and converted to 16:9 with a blurred background.
HARVEST_SHORTS=on
# Caption keyword clips: seconds per clip (3-5) and videos searched per keyword.
KEYWORD_CLIP_SECONDS=4
KEYWORD_MAX_VIDEOS=5
# 2.5-4 s micro-scenes on voice pauses (niche "pacing": {"micro": ...}; on in tech-amazon). on/off overrides.
MICRO_SCENES=
# Auto-fetch (assets step): fill missing model vaults / spec clips from YouTube before picking footage.
AUTO_FETCH=on
AUTO_FETCH_MIN_CLIPS=6
# Typo-tolerant names (letters only; digits, Roman numerals and Pro/Max/Plus... must match exactly).
FUZZY_NAMES=on
FUZZY_MIN_HITS=2
# Diagram fallback for internal specs (battery chemistry, voltage, cooling): Claude writes Manim code
# (screened, run in a temp folder), up to MANIM_ATTEMPTS repairs; else an FFmpeg template diagram.
MANIM_AGENT=on
MANIM_MODEL=claude-opus-5-5
MANIM_ATTEMPTS=3
MANIM_TIMEOUT_MS=180000

# --- AI model backup: Qwen (Settings -> AI model picks Claude / Qwen / Off, backup order, credit budget) ---
# Cloud: Alibaba Cloud Model Studio key (OpenAI-compatible endpoint). Local Ollama needs no key.
QWEN_API_KEY=
QWEN_TIMEOUT_MS=240000

# --- Stock footage (only with GENERIC_STOCK=on) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Unsplash photos (free developer key: unsplash.com/developers -> New Application -> Access Key)
UNSPLASH_ACCESS_KEY=

# Stock clip width: 1920 (sharp, ~10-20 MB/clip) or 1280 (720p, ~3-6 MB/clip, for slow internet)
STOCK_MAX_WIDTH=1920

# --- YouTube Creative Commons footage (source "youtube_cc", optional) ---
# Needs yt-dlp in .venv. Only videos whose watch page says Creative Commons are used,
# and only a 15 s piece of each is downloaded. Credits go into the description (CC BY).
# Optional proxy for YouTube requests: http://username:password@ip:port
YTDLP_PROXY=
# Live YouTube searches per assets run (each search page is ~0.5 MB).
YTCC_MAX_SEARCHES=40

# --- Web CC fallback (python/web_crawler.py): when every stock source is empty for a scene, search
# DuckDuckGo videos and use a clip only if its own page says CC BY / BY-SA / CC0 / public domain.
# WEBCC=off disables it. Crawls per assets run, and the hard kill per crawl (ms; ~70 s on a 0.2 MB/s link).
WEBCC=on
WEBCC_MAX_CRAWLS=8
WEBCC_TIMEOUT_MS=120000

# --- General web crawl (stock source "web_crawl", VidRush-style; listed in niches/documentary + general) ---
# Searches YouTube (yt-dlp ytsearch, ANY licence) and DuckDuckGo video results on yt-dlp sites. A low-res
# preview is split into shots and scored; only the picked shot is downloaded in HD. Licence is logged as
# "unknown/web" and QA warns: COPYRIGHT RISK (claims, strikes, demonetisation). WEB_CRAWL=off disables it.
WEB_CRAWL=on
# fallback = only when the other sources found fewer than WEBCRAWL_WHEN_FEWER candidates; always = every scene.
WEBCRAWL_MODE=fallback
WEBCRAWL_WHEN_FEWER=6
WEBCRAWL_MAX_SEARCHES=20
# Videos previewed per search, preview length (s, 360p) and HD seconds fetched per picked shot.
WEBCRAWL_PREVIEWS=2
WEBCRAWL_PREVIEW_SECONDS=45
WEBCRAWL_SECONDS=10
WEBCRAWL_SITES=youtube.com,youtu.be,vimeo.com,dailymotion.com,archive.org
# Shots shorter than this are dropped (python/split_shots.py, PySceneDetect ContentDetector).
SHOT_MIN_SECONDS=1.5

# --- Matching ---
# fastembed CLIP model: clip-ViT-B-32 (default) | jina-clip-v1 | "text_model,vision_model"
CLIP_MODEL=
# Claude checks the top candidates per scene (frames + narration, yes/no). Default on when ANTHROPIC_API_KEY is set.
VISION_VERIFY=on
VISION_VERIFY_TOP=3
# Footage library (cache/footage_library.sqlite): reuse stored clips whose CLIP similarity >= LIBRARY_MIN_MATCH.
FOOTAGE_LIBRARY=on
LIBRARY_MIN_MATCH=0.27

# --- Storyblocks (licensed stock video, developer.storyblocks.com): first in the stock order when set.
# Only clips that win the CLIP ranking are downloaded (downloads are counted). Test keys are for
# internal testing only - check your API agreement before publishing videos made with them.
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=

# --- Web research (Claude web search): finds each product's official page / press kit for photos,
# and 3-4 spec facts for on-screen chips. Cached per channel + product for 30 days.
# Cost: about $0.20 per new product with Opus 5.5 (measured: 5 guns = $1.06); claude-sonnet-5-5 is roughly half.
WEB_RESEARCH=on
WEB_RESEARCH_MODEL=claude-opus-5-5
# Product photos that are not 16:9 get the parallax showcase (backdrop + floating photo). off = old blurred still.
PRODUCT_PARALLAX=on

# --- Hugging Face (optional): a free read token speeds up the one-time Whisper model download ---
HF_TOKEN=

# --- Tool paths (optional; auto-detected if empty) ---
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=

# --- Whisper (step 1) ---
# large-v3-turbo: ~8x faster, half the RAM/VRAM of large-v3, near-equal English accuracy
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

# --- Render (M4+) ---
VIDEO_ENCODER=h264_nvenc
RENDER_CHUNK_SECONDS=150

# Render: segments rendered in parallel (empty = auto: 2 if >4.5 GB RAM free, else 1)
RENDER_CONCURRENCY=

# YouTube cookies for yt-dlp only (web crawl, product pools, CC search). Fixes 'Sign in to confirm you're not a bot'.
# Preferred on Windows (Chrome 127+ app-bound encryption blocks browser reading): export a Netscape cookies.txt
# for youtube.com (e.g. 'Get cookies.txt LOCALLY' extension) and point to it:
# YTDLP_COOKIES_FILE=C:\Users\you\youtube_cookies.txt
# Or read a browser directly (browser must be closed; firefox works best): chrome | edge | firefox[:profile]
# YTDLP_COOKIES_FROM_BROWSER=firefox
